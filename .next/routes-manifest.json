{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/ai",
      "regex": "^/ai(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ai(?:/)?$"
    },
    {
      "page": "/compatibility",
      "regex": "^/compatibility(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/compatibility(?:/)?$"
    },
    {
      "page": "/fortune/2026",
      "regex": "^/fortune/2026(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/fortune/2026(?:/)?$"
    },
    {
      "page": "/fortune/business",
      "regex": "^/fortune/business(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/fortune/business(?:/)?$"
    },
    {
      "page": "/mypage",
      "regex": "^/mypage(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/mypage(?:/)?$"
    },
    {
      "page": "/saju",
      "regex": "^/saju(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/saju(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}